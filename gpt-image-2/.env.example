# OpenAI-compatible relay configuration.
# Fill these two values before running generate_image.py.
GPT_IMAGE_API_URL=
GPT_IMAGE_API_KEY=

# Keep this as gpt-image-2 when the relay exposes that model name.
GPT_IMAGE_MODEL=gpt-image-2

# Optional request settings.
GPT_IMAGE_SIZE=1024x1024
GPT_IMAGE_QUALITY=auto
GPT_IMAGE_OUTPUT_FORMAT=png
